# 이 파일을 .env 로 복사한 뒤 키를 채우세요. (.env 는 깃허브에 올리지 마세요)
# 공공데이터포털 일반 인증키 (정부24 혜택, LH 공고·공급정보, 약국 공용)
DATA_GO_KR_API_KEY=
# 온통청년 오픈API 인증키
YOUTHCENTER_API_KEY=
# 카카오 REST API 키 (STEP 3 집 비교 · collect_homes.py, 장소·주소 검색)
KAKAO_REST_API_KEY=
# ODsay 대중교통 API 키 (STEP 3 집 비교 · collect_homes.py) — lab.odsay.com, 서버 IP 등록 필요
ODSAY_API_KEY=
# 화면(web/index.html)이 쓰는 브라우저용 키 — server.py 가 /api/config 로 화면에 넘겨줘요 (비워 두면 그림 지도 · 직선거리 추정)
# 카카오 JavaScript 키 (지도 + 3단계 주소·시설 검색) — 카카오 개발자 사이트 웹 플랫폼에 http://127.0.0.1:5500 등록
KAKAO_JS_KEY=
# ODsay 웹 키 (3단계 새 주소의 오가는 시간) — ODsay 웹 플랫폼에 http://127.0.0.1:5500 등록
ODSAY_WEB_KEY=
# AI 설명·RAG 답변 (scripts/explain.py, scripts/rag.py) — OpenAI 호환 API. 비워 두면 템플릿/원문 답변으로 동작
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
